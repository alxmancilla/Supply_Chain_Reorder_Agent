MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/
GROVE_API_KEY=<your-grove-api-key>
GROVE_API_BASE_URL=https://grove-gateway-prod.azure-api.net/grove-foundry-prod/openai/v1
VOYAGE_API_KEY=<your-voyage-api-key>

# ── Kafka mode (only needed when running --profile kafka) ──────────────────
# Your machine's public IP — used by Kafka to advertise the external listener
# so Atlas Stream Processing (and kafka/producer.py) can reach port 9094.
#   export HOST_IP=$(curl -s ifconfig.me)
HOST_IP=<your-public-ip>

# Kafka broker address used by kafka/consumer.py and kafka/producer.py.
# Inside Docker Compose (kafka-consumer service): kafka:9092  (set automatically)
# Outside Docker / Atlas ASP:                     <HOST_IP>:9094
KAFKA_BROKER=localhost:9094
