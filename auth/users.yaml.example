# Credentials file for the Supply Chain Reorder Agent dashboard.
#
# Copy this file to auth/users.yaml and replace hashed_password values with
# bcrypt hashes generated by streamlit-authenticator:
#
#   python -c "import streamlit_authenticator as stauth; print(stauth.Hasher(['your_password']).generate())"
#
# IMPORTANT: Do NOT commit auth/users.yaml to version control.
# It is already listed in .gitignore.

cookie:
  expiry_days: 7
  key: supply_chain_reorder_agent_cookie_key   # change to a random string in production
  name: sc_reorder_auth

credentials:
  usernames:
    admin:
      email: admin@example.com
      name: Admin User
      # Role: admin — can approve/reject orders, run compaction, view escalations
      role: admin
      hashed_password: "$2b$12$REPLACE_WITH_BCRYPT_HASH_HERE"

    approver:
      email: approver@example.com
      name: Operations Approver
      # Role: approver — can approve/reject orders
      role: approver
      hashed_password: "$2b$12$REPLACE_WITH_BCRYPT_HASH_HERE"

    viewer:
      email: viewer@example.com
      name: Read-Only Viewer
      # Role: viewer — read-only dashboard access
      role: viewer
      hashed_password: "$2b$12$REPLACE_WITH_BCRYPT_HASH_HERE"
